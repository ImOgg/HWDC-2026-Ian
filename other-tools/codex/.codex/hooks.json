{
  "hooks": {
    "SubagentStop": [
      {
        "matcher": "^coding-agent$",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File eng/verify-on-stop.ps1",
            "timeout": 900,
            "statusMessage": "Running eng/verify.ps1"
          }
        ]
      }
    ]
  }
}
